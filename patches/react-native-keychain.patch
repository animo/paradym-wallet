+/**
+ * DataStore refuses to open the same file twice in a process, and the delegate below used to be an
+ * instance member: a second `KeychainModule` — which is what a second react host in the process
+ * gets — created a second DataStore over `RN_KEYCHAIN.preferences_pb` and every read failed with
+ * "There are multiple DataStores active for the same file". Declaring the delegate at file level is
+ * the documented singleton pattern, and gives every module instance the same DataStore.
+ */
+private val dataStoreScope = CoroutineScope(Dispatchers.IO + SupervisorJob())
+
+private fun sharedPreferencesMigration(context: Context): List<DataMigration<Preferences>> {
+  return listOf(SharedPreferencesMigration(context, KEYCHAIN_DATA))
+}
+
+/**
+ * Owned by the process rather than by a module, so it outlives `KeychainModule.invalidate()`
+ * cancelling that module's scope — the surviving module's reads keep working.
+ */
+private val Context.keychainPrefs: DataStore<Preferences> by preferencesDataStore(
+  name = KEYCHAIN_DATA,
+  produceMigrations = ::sharedPreferencesMigration,
+  scope = dataStoreScope,
+)
